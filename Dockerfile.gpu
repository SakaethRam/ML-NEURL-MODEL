# NEURL Engine — GPU-accelerated image, for training GNNs at scale.
# Requires an NVIDIA GPU, driver, and the NVIDIA Container Toolkit on
# the host (`docker run --gpus all ...`).

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# CUDA-matched torch first (cu121, matching the base image's CUDA 12.1).
RUN pip install --no-cache-dir torch==2.4.0 --index-url https://download.pytorch.org/whl/cu121

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

CMD ["python", "run_pipeline.py"]
